# variables.tf — Generated by Terraflow Studio
# Add entries to the map variables below (or in terraform.auto.tfvars) to scale.

variable "aws_region" {
  description = "Default AWS region for the ODB deployment."
  type        = string
  default     = "{{ aws_region }}"
}

variable "tags" {
  description = "Tags applied to all resources."
  type        = map(string)
  default     = {}
}

# ── ODB Networks ──────────────────────────────────────────────────────────────
variable "aws_networks" {
  description = "Map of ODB Networks. Add entries here or in terraform.auto.tfvars to create more networks without any code changes."
  type = map(object({
    display_name                = string
    availability_zone_id        = string
    client_subnet_cidr          = string
    backup_subnet_cidr          = string
    s3_access                   = optional(string, "ENABLED")
    zero_etl_access             = optional(string, "DISABLED")
    availability_zone           = optional(string, "")
    region                      = optional(string, "")
    custom_domain_name          = optional(string, "")
    default_dns_prefix          = optional(string, "")
    delete_associated_resources = optional(bool, false)
  }))
  default = {}
}

{% if external_networks %}
# ── Externally provisioned ODB Networks ───────────────────────────────────────
variable "existing_odb_network_ids" {
  description = "IDs of ODB Networks provisioned outside this configuration, keyed by the network_ref used in aws_clusters / aws_peerings."
  type        = map(string)
  default     = {}
}

{% endif %}
{% if external_infras %}
# ── Externally provisioned Exadata Infrastructures ────────────────────────────
variable "existing_infra_ids" {
  description = "IDs of Exadata Infrastructures provisioned outside this configuration, keyed by the infra_ref used in aws_clusters."
  type        = map(string)
  default     = {}
}

{% endif %}
# ── Exadata Infrastructures ───────────────────────────────────────────────────
variable "aws_infras" {
  description = "Map of Exadata Infrastructures. Add entries here or in terraform.auto.tfvars to create more infras without any code changes."
  type = map(object({
    display_name                        = string
    availability_zone_id                = string
    shape                               = optional(string, "Exadata.X11M")
    compute_count                       = optional(number, 2)
    storage_count                       = optional(number, 3)
    availability_zone                   = optional(string, "")
    region                              = optional(string, "")
    database_server_type                = optional(string, "")
    storage_server_type                 = optional(string, "")
    customer_contacts                   = optional(list(string), [])
    mw_preference                       = optional(string, "NO_PREFERENCE")
    mw_patching_mode                    = optional(string, "ROLLING")
    mw_is_custom_action_timeout_enabled = optional(bool, false)
    mw_custom_action_timeout_in_mins    = optional(number, 15)
    mw_lead_time_in_weeks               = optional(number, 0)
    mw_days_of_week                     = optional(list(string), [])
    mw_months                           = optional(list(string), [])
    mw_hours_of_day                     = optional(list(number), [])
    mw_weeks_of_month                   = optional(list(number), [])
  }))
  default = {}
}

# ── Network Peerings ──────────────────────────────────────────────────────────
variable "aws_peerings" {
  description = "Map of ODB Network Peering Connections. network_ref must match a key in aws_networks."
  type = map(object({
    display_name    = string
    network_ref     = string
    peer_network_id = string
    region          = optional(string, "")
  }))
  default = {}
}

# ── VM Clusters ───────────────────────────────────────────────────────────────
variable "aws_clusters" {
  description = "Map of VM Clusters. infra_ref and network_ref must match keys in aws_infras and aws_networks."
  type = map(object({
    display_name                      = string
    gi_version                        = string
    hostname_prefix                   = string
    infra_ref                         = string
    network_ref                       = string
    cpu_core_count                    = optional(number, 16)
    license_model                     = optional(string, "LICENSE_INCLUDED")
    ssh_public_keys                   = optional(list(string), [])
    db_servers                        = optional(list(string), [])
    db_servers_mode                   = optional(string, "auto")
    dco_is_diagnostics_events_enabled = optional(bool, true)
    dco_is_health_monitoring_enabled  = optional(bool, true)
    dco_is_incident_logs_enabled      = optional(bool, true)
    cluster_name                      = optional(string, "")
    timezone                          = optional(string, "")
    data_storage_size_in_tbs          = optional(number, null)
    db_node_storage_size_in_gbs       = optional(number, null)
    memory_size_in_gbs                = optional(number, null)
    scan_listener_port_tcp            = optional(number, null)
    is_local_backup_enabled           = optional(bool, false)
    is_sparse_diskgroup_enabled       = optional(bool, false)
  }))
  default = {}
}

{% for av in avmclusters %}
# ── {{ av.module_name }} ──────────────────────────────────────────────────────
variable "{{ av.module_name }}_display_name" {
  type    = string
  default = "{{ av.display_name }}"
}
variable "{{ av.module_name }}_autonomous_data_storage_size_in_tbs" {
  type    = number
  default = {{ av.autonomous_data_storage_size_in_tbs }}
}
variable "{{ av.module_name }}_cpu_core_count_per_node" {
  type    = number
  default = {{ av.cpu_core_count_per_node }}
}
variable "{{ av.module_name }}_memory_per_oracle_compute_unit_in_gbs" {
  type    = number
  default = {{ av.memory_per_oracle_compute_unit_in_gbs }}
}
variable "{{ av.module_name }}_total_container_databases" {
  type    = number
  default = {{ av.total_container_databases }}
}
variable "{{ av.module_name }}_license_model" {
  type    = string
  default = "{{ av.license_model }}"
}
{% endfor %}

{% if oci_databases %}
# ── OCI provider ──────────────────────────────────────────────────────────────
variable "oci_auth_method" {
  type    = string
  default = "APIKey"
}
variable "oci_region" {
  type    = string
  default = "{{ oci_region }}"
}
variable "oci_tenancy_ocid" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_user_ocid" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_fingerprint" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_private_key_path" {
  type    = string
  default = "~/.oci/oci_api_key.pem"
}

{% for db in oci_databases %}
# Set via: export TF_VAR_{{ db.module_name }}_admin_password=...
variable "{{ db.module_name }}_admin_password" {
  type      = string
  sensitive = true
}
{% endfor %}
{% endif %}
