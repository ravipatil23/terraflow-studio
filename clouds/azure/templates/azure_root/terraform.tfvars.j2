# terraform.tfvars — Generated by Terraflow Studio
# All module-specific values are consolidated here at the root level.

subscription_id     = "{{ subscription_id }}"
resource_group_name = "{{ resource_group_name }}"
location            = "{{ location }}"
{% if tags %}
tags = {
{% for k, v in tags.items() %}
  "{{ k }}" = "{{ v }}"
{% endfor %}
}
{% endif %}

{% for anc in anchors %}
# ── {{ anc.module_name }} ─────────────────────────────────────────────────────
{{ anc.module_name }}_name = "{{ anc.name }}"
{% endfor %}

{% for net in vnets %}
# ── {{ net.module_name }} ─────────────────────────────────────────────────────
{{ net.module_name }}_vnet_name             = "{{ net.vnet_name }}"
{{ net.module_name }}_address_space         = "{{ net.address_space }}"
{{ net.module_name }}_subnet_name           = "{{ net.subnet_name }}"
{{ net.module_name }}_subnet_address_prefix = "{{ net.subnet_address_prefix }}"
{% endfor %}

{% for inf in infras %}
# ── {{ inf.module_name }} ─────────────────────────────────────────────────────
{{ inf.module_name }}_name          = "{{ inf.name }}"
{{ inf.module_name }}_display_name  = "{{ inf.display_name }}"
{{ inf.module_name }}_shape         = "{{ inf.shape }}"
{{ inf.module_name }}_compute_count = {{ inf.compute_count }}
{{ inf.module_name }}_storage_count = {{ inf.storage_count }}
{{ inf.module_name }}_zone          = "{{ inf.zone }}"
{% endfor %}

{% for cl in clusters %}
# ── {{ cl.module_name }} ──────────────────────────────────────────────────────
{{ cl.module_name }}_name                        = "{{ cl.name }}"
{{ cl.module_name }}_display_name                = "{{ cl.display_name }}"
{{ cl.module_name }}_hostname                    = "{{ cl.hostname }}"
{{ cl.module_name }}_cpu_core_count              = {{ cl.cpu_core_count }}
{{ cl.module_name }}_data_storage_size_in_tbs    = {{ cl.data_storage_size_in_tbs }}
{{ cl.module_name }}_memory_size_in_gbs          = {{ cl.memory_size_in_gbs }}
{{ cl.module_name }}_db_node_storage_size_in_gbs = {{ cl.db_node_storage_size_in_gbs }}
{{ cl.module_name }}_gi_version                  = "{{ cl.gi_version }}"
{{ cl.module_name }}_license_model               = "{{ cl.license_model }}"
{{ cl.module_name }}_ssh_public_keys             = {{ cl.ssh_public_keys | tojson }}
{{ cl.module_name }}_local_backup_enabled        = {{ cl.local_backup_enabled | lower }}
{{ cl.module_name }}_sparse_diskgroup_enabled    = {{ cl.sparse_diskgroup_enabled | lower }}
{{ cl.module_name }}_cluster_name                = "{{ cl.cluster_name }}"
{{ cl.module_name }}_time_zone                   = "{{ cl.time_zone }}"
{{ cl.module_name }}_scan_listener_port_tcp      = {{ cl.scan_listener_port_tcp }}
{% endfor %}
