variable "subscription_id" {
  type        = string
  description = "Azure subscription ID"
  default     = "{{ subscription_id }}"
}
variable "resource_group_name" {
  type        = string
  description = "Azure resource group name"
  default     = "{{ resource_group_name }}"
}
variable "location" {
  type        = string
  description = "Azure region"
  default     = "{{ location }}"
}
variable "tags" {
  type    = map(string)
  default = {}
}

{% for anc in anchors %}
# ── {{ anc.module_name }} ─────────────────────────────────────────────────────
variable "{{ anc.module_name }}_name" {
  type    = string
  default = "{{ anc.name }}"
}
{% endfor %}

{% for net in vnets %}
# ── {{ net.module_name }} ─────────────────────────────────────────────────────
variable "{{ net.module_name }}_vnet_name" {
  type    = string
  default = "{{ net.vnet_name }}"
}
variable "{{ net.module_name }}_address_space" {
  type    = string
  default = "{{ net.address_space }}"
}
variable "{{ net.module_name }}_subnet_name" {
  type    = string
  default = "{{ net.subnet_name }}"
}
variable "{{ net.module_name }}_subnet_address_prefix" {
  type    = string
  default = "{{ net.subnet_address_prefix }}"
}
{% endfor %}

{% for inf in infras %}
# ── {{ inf.module_name }} ─────────────────────────────────────────────────────
variable "{{ inf.module_name }}_name" {
  type    = string
  default = "{{ inf.name }}"
}
variable "{{ inf.module_name }}_display_name" {
  type    = string
  default = "{{ inf.display_name }}"
}
variable "{{ inf.module_name }}_shape" {
  type    = string
  default = "{{ inf.shape }}"
}
variable "{{ inf.module_name }}_compute_count" {
  type    = number
  default = {{ inf.compute_count }}
}
variable "{{ inf.module_name }}_storage_count" {
  type    = number
  default = {{ inf.storage_count }}
}
variable "{{ inf.module_name }}_zone" {
  type    = string
  default = "{{ inf.zone }}"
}
{% endfor %}

{% for cl in clusters %}
# ── {{ cl.module_name }} ──────────────────────────────────────────────────────
variable "{{ cl.module_name }}_name" {
  type    = string
  default = "{{ cl.name }}"
}
variable "{{ cl.module_name }}_display_name" {
  type    = string
  default = "{{ cl.display_name }}"
}
variable "{{ cl.module_name }}_hostname" {
  type    = string
  default = "{{ cl.hostname }}"
}
variable "{{ cl.module_name }}_cpu_core_count" {
  type    = number
  default = {{ cl.cpu_core_count }}
}
variable "{{ cl.module_name }}_data_storage_size_in_tbs" {
  type    = number
  default = {{ cl.data_storage_size_in_tbs }}
}
variable "{{ cl.module_name }}_memory_size_in_gbs" {
  type    = number
  default = {{ cl.memory_size_in_gbs }}
}
variable "{{ cl.module_name }}_db_node_storage_size_in_gbs" {
  type    = number
  default = {{ cl.db_node_storage_size_in_gbs }}
}
variable "{{ cl.module_name }}_gi_version" {
  type    = string
  default = "{{ cl.gi_version }}"
}
variable "{{ cl.module_name }}_license_model" {
  type    = string
  default = "{{ cl.license_model }}"
}
variable "{{ cl.module_name }}_ssh_public_keys" {
  type    = list(string)
  default = {{ cl.ssh_public_keys | tojson }}
}
variable "{{ cl.module_name }}_local_backup_enabled" {
  type    = bool
  default = {{ cl.local_backup_enabled | lower }}
}
variable "{{ cl.module_name }}_sparse_diskgroup_enabled" {
  type    = bool
  default = {{ cl.sparse_diskgroup_enabled | lower }}
}
variable "{{ cl.module_name }}_cluster_name" {
  type    = string
  default = "{{ cl.cluster_name }}"
}
variable "{{ cl.module_name }}_time_zone" {
  type    = string
  default = "{{ cl.time_zone }}"
}
variable "{{ cl.module_name }}_scan_listener_port_tcp" {
  type    = number
  default = {{ cl.scan_listener_port_tcp }}
}
{% endfor %}
