#
# NOTE: exadata_infrastructure, exadata_infrastructure_id, odb_network, odb_subnet,
# and backup_odb_subnet are supplied from root main.tf module outputs — no need to
# set them here. They are wired automatically:
#   exadata_infrastructure    = module.{{ mn3 }}.infra_self_link
#   exadata_infrastructure_id = module.{{ mn3 }}.infra_id
#   odb_network               = module.{{ mn0 }}.odb_network_name
#   odb_subnet                = module.{{ mn0 }}.client_subnet_name
#   backup_odb_subnet         = module.{{ mn0 }}.backup_subnet_name

cloud_vm_cluster_id = "{{ cloud_vm_cluster_id }}"
display_name        = "{{ display_name }}"
location            = "{{ location }}"
{% if project %}
project             = "{{ project }}"
{% else %}
# project             = "my-gcp-project"
{% endif %}
deletion_protection = {{ deletion_protection }}

# ── properties ────────────────────────────────────────────────────────────────
gi_version               = "{{ gi_version }}"
hostname_prefix          = "{{ hostname_prefix }}"
cpu_core_count           = {{ cpu_core_count }}
memory_size_gb           = {{ memory_size_gb }}
db_node_storage_size_gb  = {{ db_node_storage_size_gb }}
data_storage_size_tb     = {{ data_storage_size_tb }}
local_backup_enabled     = {{ local_backup_enabled }}
sparse_diskgroup_enabled = {{ sparse_diskgroup_enabled }}
license_type             = "{{ license_type }}"
{% if cluster_name %}
cluster_name             = "{{ cluster_name }}"
{% else %}
# cluster_name             = "my-cluster"   # max 11 chars
{% endif %}
{% if scan_listener_port_tcp and scan_listener_port_tcp != 'null' %}
scan_listener_port_tcp   = {{ scan_listener_port_tcp }}
{% else %}
# scan_listener_port_tcp   = 1521
{% endif %}
{% if time_zone %}
time_zone                = "{{ time_zone }}"
{% else %}
# time_zone                = "UTC"
{% endif %}

ssh_public_keys = [
{% for k in ssh_public_keys %}
  "{{ k }}",
{% else %}
  # "ssh-rsa AAAA...",
{% endfor %}
]

# db_server_ocids — leave empty to auto-discover from Exadata Infrastructure.
# Populate to pin the cluster to specific DB servers.
db_server_ocids = [
{% for o in db_server_ocids %}
  "{{ o }}",
{% endfor %}
]

labels = {
{% for k, v in labels.items() %}
  "{{ k }}" = "{{ v }}"
{% else %}
  "managed-by" = "terraform"
{% endfor %}
}
