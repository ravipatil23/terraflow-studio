# terraform.auto.tfvars — Generated by Terraflow Studio
# To add resources without re-running the generator, append new map entries below.

gcp_project = "{{ gcp_project }}"
gcp_region  = "{{ gcp_region }}"

gcp_odb_networks = {
{% for net in networks %}
  "{{ net.module_name }}" = {
    odb_network_id      = "{{ net.odb_network_id }}"
    network             = "{{ net.network }}"
    gcp_oracle_zone     = "{{ net.gcp_oracle_zone }}"
    client_subnet_id    = "{{ net.client_subnet_id }}"
    client_cidr_range   = "{{ net.client_cidr }}"
    backup_subnet_id    = "{{ net.backup_subnet_id }}"
    backup_cidr_range   = "{{ net.backup_cidr }}"
    deletion_protection = {{ net.deletion_protection | lower }}
    labels              = {% if net.labels %}{ {% for k, v in net.labels.items() %}"{{ k }}" = "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}{}{% endif +%}
  }
{% endfor %}
}

gcp_exadata_infras = {
{% for inf in infras %}
  "{{ inf.module_name }}" = {
    cloud_exadata_infrastructure_id = "{{ inf.cloud_exadata_infrastructure_id }}"
    display_name                    = "{{ inf.display_name }}"
    gcp_oracle_zone                 = "{{ inf.gcp_oracle_zone }}"
    shape                           = "{{ inf.shape }}"
    compute_count                   = {{ inf.compute_count }}
    storage_count                   = {{ inf.storage_count }}
{% if inf.total_storage_size_gb %}
    total_storage_size_gb           = {{ inf.total_storage_size_gb }}
{% endif %}
    mw_preference                   = "{{ inf.mw_preference }}"
    mw_patching_mode                = "{{ inf.mw_patching_mode }}"
    deletion_protection             = {{ inf.deletion_protection | lower }}
    labels                          = {% if inf.labels %}{ {% for k, v in inf.labels.items() %}"{{ k }}" = "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}{}{% endif +%}
  }
{% endfor %}
}

gcp_vm_clusters = {
{% for cl in clusters %}
  "{{ cl.module_name }}" = {
    infra_key                = "{{ cl.infra_ref }}"
    network_key              = "{{ cl.network_ref }}"
    cloud_vm_cluster_id      = "{{ cl.cloud_vm_cluster_id }}"
    display_name             = "{{ cl.display_name }}"
    hostname_prefix          = "{{ cl.hostname_prefix }}"
    cpu_core_count           = {{ cl.cpu_core_count }}
    memory_size_gb           = {{ cl.memory_size_gb }}
    db_node_storage_size_gb  = {{ cl.db_node_storage_size_gb }}
    data_storage_size_tb     = {{ cl.data_storage_size_tb }}
    gi_version               = "{{ cl.gi_version }}"
    license_type             = "{{ cl.license_type }}"
    ssh_public_keys          = [{{ cl.ssh_public_keys | map("tojson") | join(", ") }}]
    local_backup_enabled     = {{ cl.local_backup_enabled | lower }}
    sparse_diskgroup_enabled = {{ cl.sparse_diskgroup_enabled | lower }}
{% if cl.location %}
    location                 = "{{ cl.location }}"
{% endif %}
{% if cl.project %}
    project                  = "{{ cl.project }}"
{% endif %}
{% if cl.cluster_name %}
    cluster_name             = "{{ cl.cluster_name }}"
{% endif %}
{% if cl.time_zone %}
    time_zone                = "{{ cl.time_zone }}"
{% endif %}
{% if cl.scan_listener_port_tcp is not none %}
    scan_listener_port_tcp   = {{ cl.scan_listener_port_tcp }}
{% endif %}
    dco_diagnostics          = {{ cl.dco_diagnostics | lower }}
    dco_health               = {{ cl.dco_health | lower }}
    dco_incident_logs        = {{ cl.dco_incident_logs | lower }}
    deletion_protection      = {{ cl.deletion_protection | lower }}
    labels                   = {% if cl.labels %}{ {% for k, v in cl.labels.items() %}"{{ k }}" = "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}{}{% endif +%}
  }
{% endfor %}
}
