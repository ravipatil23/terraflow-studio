    { "region": "eu-north-1",     "label": "Europe (Stockholm)",       "zones": [],                         "status": "planned", "oci_label": "TBD",                         "oci_region": null },
    { "region": "eu-central-2",   "label": "Europe (Zurich)",          "zones": ["euc2-az1", "euc2-az3"],   "status": "live",    "oci_label": "Switzerland North (Zurich)",  "oci_region": null },
    { "region": "ap-south-2",     "label": "Asia Pacific (Hyderabad)", "zones": ["aps2-az1", "aps2-az3"],   "status": "live",    "oci_label": "India South (Hyderabad)",     "oci_region": null },
