    { "region": "eu-west-2",      "label": "Europe (London)",          "zones": ["euw2-az1", "euw2-az3"],   "status": "live",    "oci_label": "UK South (London)",           "oci_region": null },
    { "region": "eu-south-1",     "label": "Europe (Milan)",           "zones": ["eus1-az3"],               "status": "live",    "oci_label": "Italy Northwest (Milan)",     "oci_region": null },
