{
  "_comment": [
    "Oracle Database@AWS region and availability-zone catalogue. Single source of",
    "truth for both the browser (region/AZ dropdowns on the AWS page) and the",
    "generator (the OCI provider region written into the root module).",
    "",
    "Edit this file to add a region or AZ — no code change needed. Restart the app",
    "to pick up changes.",
    "",
    "Fields per entry:",
    "  region      AWS region code. Must be unique; this is the key everything joins on.",
    "  label       Human name shown in the region dropdown.",
    "  zones       AWS availability-zone IDs where ODB@AWS is offered. Order is preserved.",
    "              These are AZ *IDs* (use1-az4), not AZ names (us-east-1a) - the ID is",
    "              stable across accounts, the name is not.",
    "  status      'live'    - offered in the dropdown normally.",
    "              'planned' - shown greyed out and unselectable-looking; leave zones empty.",
    "  oci_label   The paired OCI region's display name. Documentation only.",
    "  oci_region  The paired OCI region *identifier*, e.g. 'us-ashburn-1'. This is written",
    "              into the generated OCI provider block, so a wrong value produces",
    "              Terraform that targets the wrong region. null means unmapped: the",
    "              generator falls back to 'us-ashburn-1'. Fill these in as you confirm",
    "              them - see README notes on the eu-west-1 mapping."
  ],
  "default_oci_region": "us-ashburn-1",
  "regions": [
    { "region": "us-east-1",      "label": "US East (N. Virginia)",    "zones": ["use1-az4", "use1-az6"],   "status": "live",    "oci_label": "US East (Ashburn)",           "oci_region": "us-ashburn-1" },
    { "region": "us-east-2",      "label": "US East (Ohio)",           "zones": ["use2-az1", "use2-az2"],   "status": "live",    "oci_label": "US Central (Columbus)",       "oci_region": "us-chicago-1" },
    { "region": "us-west-2",      "label": "US West (Oregon)",         "zones": ["usw2-az3", "usw2-az4"],   "status": "live",    "oci_label": "US West (Boardman)",          "oci_region": "us-portland-1" },
    { "region": "eu-central-1",   "label": "Europe (Frankfurt)",       "zones": ["euc1-az1", "euc1-az2"],   "status": "live",    "oci_label": "Germany Central (Frankfurt)", "oci_region": "eu-frankfurt-1" },
    { "region": "ap-northeast-1", "label": "Asia Pacific (Tokyo)",     "zones": ["apne1-az1", "apne1-az4"], "status": "live",    "oci_label": "Japan East (Tokyo)",          "oci_region": "ap-tokyo-1" },
    { "region": "ca-central-1",   "label": "Canada (Central)",         "zones": ["cac1-az1", "cac1-az4"],   "status": "live",    "oci_label": "Canada Southeast (Montreal)", "oci_region": null },
