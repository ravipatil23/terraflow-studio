{
  "_comment": [
    "Oracle Database@GCP region and Oracle-zone catalogue. Single source of truth",
    "for both the browser (region/zone dropdowns on the GCP page) and the",
    "generator (the OCI provider region written into the root module).",
    "",
    "Edit this file to add a region or zone - no code change needed. Restart the",
    "app to pick up changes.",
    "",
    "Fields per entry:",
    "  region      GCP region code, e.g. 'us-east4'. Unique; everything joins on it.",
    "  label       Human name shown in the dropdown.",
    "  zones       Oracle zones offered in that region, e.g. 'us-east4-b-r1'. These",
    "              are Oracle's zone names, not plain GCP zones - note the -r1/-r2",
    "              suffix identifying the Oracle rack.",
    "  status      'live'    - offered in the dropdown normally.",
    "              'planned' - shown greyed out; leave zones empty and oci_region null.",
    "  oci_label   The paired OCI region's display name, shown beneath the picker.",
    "  oci_region  The paired OCI region *identifier*, e.g. 'us-ashburn-1'. Written",
    "              into the generated OCI provider block, so a wrong value produces",
    "              Terraform targeting the wrong region. null for planned regions,",
    "              which fall back to default_oci_region."
  ],
  "default_oci_region": "us-ashburn-1",
  "regions": [
    { "region": "us-east4",                "label": "N. Virginia (us-east4)",                  "zones": ["us-east4-b-r1", "us-east4-a-r2"],                          "status": "live",    "oci_label": "US East (Ashburn)",               "oci_region": "us-ashburn-1" },
    { "region": "us-central1",             "label": "Iowa / Council Bluffs (us-central1)",     "zones": ["us-central1-a-r1"],                                        "status": "live",    "oci_label": "US Midwest (Des Moines)",         "oci_region": "us-desmoines-1" },
    { "region": "us-west3",                "label": "Salt Lake City (us-west3)",               "zones": ["us-west3-a-r1"],                                           "status": "live",    "oci_label": "US West (Salt Lake City)",        "oci_region": "us-saltlake-2" },
    { "region": "northamerica-northeast1", "label": "Montréal (northamerica-northeast1)",      "zones": ["northamerica-northeast1-a-r1"],                            "status": "live",    "oci_label": "Canada Southeast (Montreal)",     "oci_region": "ca-montreal-1" },
    { "region": "northamerica-northeast2", "label": "Toronto (northamerica-northeast2)",       "zones": ["northamerica-northeast2-a-r2"],                            "status": "live",    "oci_label": "Canada Southeast (Toronto)",      "oci_region": "ca-toronto-1" },
