# main.tf — Generated by Terraflow Studio
# Root module: OCI Cross-Region Data Guard Networking
# Apply order: module.primary + module.dr run in parallel → module.drg_peering

terraform {
  required_providers {
    oci = {
      source  = "oracle/oci"
      version = ">= 6.0.0"
    }
  }
}

provider "oci" {
  alias  = "primary"
  region = var.primary_region
}

provider "oci" {
  alias  = "dr"
  region = var.dr_region
}

# ── Module 1: Primary Region ──────────────────────────────────────────────────

module "primary" {
  source = "./modules/oci-dg-primary"
  providers = {
    oci = oci.primary
  }

  prefix                 = "${var.prefix}-primary"
  compartment_id         = var.compartment_id
  hub_cidr               = var.primary_hub_cidr
  cluster_vcn_id         = var.primary_vcn_id
  cluster_nsg_id         = var.primary_nsg_id
  cluster_route_table_id = var.primary_route_table_id
  local_client_cidr      = var.primary_client_cidr
  remote_client_cidr     = var.dr_client_cidr
}

# ── Module 2: DR Region ───────────────────────────────────────────────────────

module "dr" {
  source = "./modules/oci-dg-dr"
  providers = {
    oci = oci.dr
  }

  prefix                 = "${var.prefix}-dr"
  compartment_id         = var.compartment_id
  hub_cidr               = var.dr_hub_cidr
  cluster_vcn_id         = var.dr_vcn_id
  cluster_nsg_id         = var.dr_nsg_id
  cluster_route_table_id = var.dr_route_table_id
  local_client_cidr      = var.dr_client_cidr
  remote_client_cidr     = var.primary_client_cidr
}

# ── Module 3: DRG Peering ─────────────────────────────────────────────────────

module "drg_peering" {
  source = "./modules/oci-dg-peering"
  providers = {
    oci.primary = oci.primary
    oci.dr      = oci.dr
  }

  prefix         = var.prefix
  compartment_id = var.compartment_id
  primary_drg_id = module.primary.drg_id
  dr_drg_id      = module.dr.drg_id
  dr_region      = var.dr_region

  depends_on = [module.primary, module.dr]
}

# ── Outputs ───────────────────────────────────────────────────────────────────

output "primary_hub_vcn_id" { value = module.primary.hub_vcn_id }
output "dr_hub_vcn_id"      { value = module.dr.hub_vcn_id }
output "primary_drg_id"     { value = module.primary.drg_id }
output "dr_drg_id"          { value = module.dr.drg_id }
output "primary_rpc_id"     { value = module.drg_peering.primary_rpc_id }
output "dr_rpc_id"          { value = module.drg_peering.dr_rpc_id }
output "peering_status"     { value = module.drg_peering.peering_status }
