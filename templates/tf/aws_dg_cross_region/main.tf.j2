terraform {
  required_providers {
    oci = {
      source  = "oracle/oci"
      version = ">= 6.0.0"
    }
  }
}

# Two provider aliases — one per OCI region
provider "oci" {
  alias  = "primary"
  region = var.primary_oci_region
  # Auth: TF_VAR_* env vars or ~/.oci/config
}

provider "oci" {
  alias  = "standby"
  region = var.standby_oci_region
}

# ════════════════════════════════════════════════════════════════════════════════
# PRIMARY REGION
# ════════════════════════════════════════════════════════════════════════════════

# ─── Hub VCN ─────────────────────────────────────────────────────────────────

resource "oci_core_vcn" "primary_hub" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  cidr_blocks    = [var.primary_hub_cidr]
  display_name   = "${var.prefix}-primary-hub-vcn"
}

# ─── LPG in Hub VCN (peers with primary_lpg, uses transit_lpg route table) ───

resource "oci_core_local_peering_gateway" "primary_hub_lpg" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.primary_hub.id
  display_name   = "${var.prefix}-primary-hub-lpg"
  peer_id        = oci_core_local_peering_gateway.primary_lpg.id
  route_table_id = oci_core_route_table.primary_hub_transit_lpg.id
}

# ─── LPG in Primary VM Cluster VCN ───────────────────────────────────────────

resource "oci_core_local_peering_gateway" "primary_lpg" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  vcn_id         = var.primary_vcn_id
  display_name   = "${var.prefix}-primary-lpg"
}

# ─── Dynamic Routing Gateway ──────────────────────────────────────────────────

resource "oci_core_drg" "primary_hub_drg" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  display_name   = "${var.prefix}-primary-hub-drg"
}

# ─── Route table: DRG-side → primary VCN via hub LPG ─────────────────────────
# Applied to the DRG attachment so traffic from standby routes to primary VCN.

resource "oci_core_route_table" "primary_hub_transit_drg" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.primary_hub.id
  display_name   = "${var.prefix}-primary-hub-transit-drg"

  route_rules {
    network_entity_id = oci_core_local_peering_gateway.primary_hub_lpg.id
    destination       = var.primary_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "From DRG to primary VCN via hub LPG"
  }
}

# ─── Route table: LPG-side → standby via DRG ─────────────────────────────────
# Applied to primary_hub_lpg so traffic from primary VCN routes toward standby.

resource "oci_core_route_table" "primary_hub_transit_lpg" {
  provider       = oci.primary
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.primary_hub.id
  display_name   = "${var.prefix}-primary-hub-transit-lpg"

  route_rules {
    network_entity_id = oci_core_drg.primary_hub_drg.id
    destination       = var.standby_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "From primary VCN to standby region via DRG"
  }
}

# ─── DRG Attachment to Hub VCN ───────────────────────────────────────────────

resource "oci_core_drg_attachment" "primary_hub_drg_attachment" {
  provider     = oci.primary
  drg_id       = oci_core_drg.primary_hub_drg.id
  display_name = "${var.prefix}-primary-hub-drg-attachment"

  network_details {
    id             = oci_core_vcn.primary_hub.id
    type           = "VCN"
    route_table_id = oci_core_route_table.primary_hub_transit_drg.id
  }
  # DRG route table uses OCI autogenerated table with ALL-routes import distribution
}

# ─── Remote Peering Connection ────────────────────────────────────────────────

resource "oci_core_remote_peering_connection" "primary_rpc" {
  provider         = oci.primary
  compartment_id   = var.compartment_id
  drg_id           = oci_core_drg.primary_hub_drg.id
  display_name     = "${var.prefix}-primary-rpc"
  peer_id          = oci_core_remote_peering_connection.standby_rpc.id
  peer_region_name = var.standby_oci_region
}

# ─── Primary VCN default route table ─────────────────────────────────────────
# IMPORTANT: import before apply to preserve existing rules:
#   terraform import oci_core_default_route_table.primary_rt {{ primary_route_table_id or "<primary-rt-ocid>" }}

resource "oci_core_default_route_table" "primary_rt" {
  provider                   = oci.primary
  manage_default_resource_id = var.primary_route_table_id

  route_rules {
    network_entity_id = oci_core_local_peering_gateway.primary_lpg.id
    destination       = var.standby_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "Data Guard: route to standby region via Hub"
  }
  # TODO: add any pre-existing route rules here before applying
}

# ─── Primary NSG: allow TCP 1521 from standby ────────────────────────────────

resource "oci_core_network_security_group_security_rule" "primary_dg_ingress" {
  provider                  = oci.primary
  network_security_group_id = var.primary_nsg_id
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.standby_client_cidr
  source_type               = "CIDR_BLOCK"
  description               = "Data Guard ingress from standby region"

  tcp_options {
    destination_port_range {
      min = 1521
      max = 1521
    }
  }
}
{% if add_ssh %}

resource "oci_core_network_security_group_security_rule" "primary_ssh_ingress" {
  provider                  = oci.primary
  network_security_group_id = var.primary_nsg_id
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.standby_client_cidr
  source_type               = "CIDR_BLOCK"
  description               = "SSH from standby region"

  tcp_options {
    destination_port_range {
      min = 22
      max = 22
    }
  }
}
{% endif %}

# ════════════════════════════════════════════════════════════════════════════════
# STANDBY REGION
# ════════════════════════════════════════════════════════════════════════════════

# ─── Hub VCN ─────────────────────────────────────────────────────────────────

resource "oci_core_vcn" "standby_hub" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  cidr_blocks    = [var.standby_hub_cidr]
  display_name   = "${var.prefix}-standby-hub-vcn"
}

# ─── LPG in Standby Hub VCN ──────────────────────────────────────────────────

resource "oci_core_local_peering_gateway" "standby_hub_lpg" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.standby_hub.id
  display_name   = "${var.prefix}-standby-hub-lpg"
  peer_id        = oci_core_local_peering_gateway.standby_lpg.id
  route_table_id = oci_core_route_table.standby_hub_transit_lpg.id
}

# ─── LPG in Standby VM Cluster VCN ───────────────────────────────────────────

resource "oci_core_local_peering_gateway" "standby_lpg" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  vcn_id         = var.standby_vcn_id
  display_name   = "${var.prefix}-standby-lpg"
}

# ─── Dynamic Routing Gateway ──────────────────────────────────────────────────

resource "oci_core_drg" "standby_hub_drg" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  display_name   = "${var.prefix}-standby-hub-drg"
}

# ─── Route table: DRG-side → standby VCN via hub LPG ────────────────────────

resource "oci_core_route_table" "standby_hub_transit_drg" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.standby_hub.id
  display_name   = "${var.prefix}-standby-hub-transit-drg"

  route_rules {
    network_entity_id = oci_core_local_peering_gateway.standby_hub_lpg.id
    destination       = var.standby_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "From DRG to standby VCN via hub LPG"
  }
}

# ─── Route table: LPG-side → primary via DRG ─────────────────────────────────

resource "oci_core_route_table" "standby_hub_transit_lpg" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.standby_hub.id
  display_name   = "${var.prefix}-standby-hub-transit-lpg"

  route_rules {
    network_entity_id = oci_core_drg.standby_hub_drg.id
    destination       = var.primary_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "From standby VCN to primary region via DRG"
  }
}

# ─── DRG Attachment to Standby Hub VCN ───────────────────────────────────────

resource "oci_core_drg_attachment" "standby_hub_drg_attachment" {
  provider     = oci.standby
  drg_id       = oci_core_drg.standby_hub_drg.id
  display_name = "${var.prefix}-standby-hub-drg-attachment"

  network_details {
    id             = oci_core_vcn.standby_hub.id
    type           = "VCN"
    route_table_id = oci_core_route_table.standby_hub_transit_drg.id
  }
}

# ─── Remote Peering Connection (acceptor — no peer_id set here) ──────────────

resource "oci_core_remote_peering_connection" "standby_rpc" {
  provider       = oci.standby
  compartment_id = var.compartment_id
  drg_id         = oci_core_drg.standby_hub_drg.id
  display_name   = "${var.prefix}-standby-rpc"
}

# ─── Standby VCN default route table ─────────────────────────────────────────
# IMPORTANT: import before apply to preserve existing rules:
#   terraform import oci_core_default_route_table.standby_rt {{ standby_route_table_id or "<standby-rt-ocid>" }}

resource "oci_core_default_route_table" "standby_rt" {
  provider                   = oci.standby
  manage_default_resource_id = var.standby_route_table_id

  route_rules {
    network_entity_id = oci_core_local_peering_gateway.standby_lpg.id
    destination       = var.primary_client_cidr
    destination_type  = "CIDR_BLOCK"
    description       = "Data Guard: route to primary region via Hub"
  }
  # TODO: add any pre-existing route rules here before applying
}

# ─── Standby NSG: allow TCP 1521 from primary ────────────────────────────────

resource "oci_core_network_security_group_security_rule" "standby_dg_ingress" {
  provider                  = oci.standby
  network_security_group_id = var.standby_nsg_id
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.primary_client_cidr
  source_type               = "CIDR_BLOCK"
  description               = "Data Guard ingress from primary region"

  tcp_options {
    destination_port_range {
      min = 1521
      max = 1521
    }
  }
}
{% if add_ssh %}

resource "oci_core_network_security_group_security_rule" "standby_ssh_ingress" {
  provider                  = oci.standby
  network_security_group_id = var.standby_nsg_id
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.primary_client_cidr
  source_type               = "CIDR_BLOCK"
  description               = "SSH from primary region"

  tcp_options {
    destination_port_range {
      min = 22
      max = 22
    }
  }
}
{% endif %}
