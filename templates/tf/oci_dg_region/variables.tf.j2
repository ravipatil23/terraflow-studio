variable "prefix" {
  description = "Name prefix for all resources in this region module"
  type        = string
}

variable "compartment_id" {
  description = "OCI compartment OCID"
  type        = string
  sensitive   = true
}

variable "hub_cidr" {
  description = "CIDR for the Hub (transit) VCN, e.g. 10.15.0.0/24"
  type        = string
}

variable "cluster_vcn_id" {
  description = "OCID of the existing VM Cluster VCN"
  type        = string
}

variable "cluster_nsg_id" {
  description = "OCID of the VM Cluster Network Security Group"
  type        = string
}

variable "cluster_route_table_id" {
  description = "OCID of the VM Cluster VCN default route table — must be imported before apply"
  type        = string
}

variable "local_client_cidr" {
  description = "CIDR of this region's client subnet, e.g. 10.10.1.0/24"
  type        = string
}

variable "remote_client_cidr" {
  description = "CIDR of the remote (peer) region's client subnet, e.g. 10.30.1.0/24"
  type        = string
}
